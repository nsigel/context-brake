{
  "name": "context-brake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "bun run build:context-brake && bun run build:compaction-server",
    "build:context-brake": "bun run --cwd apps/context-brake build",
    "build:compaction-server": "bun run --cwd apps/compaction-server build",
    "docker:build": "docker build -f apps/compaction-server/Dockerfile -t context-brake-compaction-server .",
    "dev": "bun run --cwd apps/context-brake dev",
    "dev:compaction-server": "bun run --cwd apps/compaction-server dev",
    "start": "bun run --cwd apps/context-brake start",
    "test": "bun test apps/context-brake/test apps/compaction-server/test",
    "typecheck": "bun run --cwd apps/context-brake typecheck && bun run --cwd apps/compaction-server typecheck"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
